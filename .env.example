# ───────────────────────── HiloCoinBot configuration ─────────────────────────
# Copy this file to .env and fill in the values.

# Bot token from @BotFather
BOT_TOKEN=123456789:AA...your-token...

# Public HTTPS address of this server (the Mini App URL), without a trailing slash.
# Example: https://hilocoin.example.com  or an ngrok / cloudflared tunnel URL.
WEBAPP_URL=https://your-domain.com

# Admin panel password (open https://your-domain.com/admin/). Use a long random password!
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Telegram user IDs of admins (comma separated). They can use /admin and /stats in the bot,
# receive broadcast test messages and use the app during maintenance mode.
ADMIN_IDS=

# HTTP port
PORT=3000

# polling (default, simplest) or webhook (uses WEBAPP_URL)
BOT_MODE=polling

# SQLite database location (default: ./data/hilocoin.db)
# DB_PATH=./data/hilocoin.db

# Local testing only: open http://localhost:3000/?dev_user=123 in a normal browser.
# NEVER enable in production — it lets anyone log in as any user.
DEV_MODE=false
